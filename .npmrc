# @gurukulams packages (practice-js) are hosted on GitHub Packages.
# GitHub Packages requires a token even for public packages, so every place that
# runs `npm install` needs NODE_AUTH_TOKEN set:
#   locally  — a PAT with the read:packages scope
#   Actions  — secrets.GITHUB_TOKEN, with `permissions: packages: read`
@gurukulams:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
